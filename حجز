<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>حجز مجموعات - أستاذة نسمة</title>
    <style>
        * { box-sizing: border-box; font-family: 'Tahoma', sans-serif; margin: 0; padding: 0; }
        
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 15px;
        }

        .container {
            background: white;
            padding: 25px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            width: 100%;
            max-width: 400px;
        }

        .badge {
            background: #fdcb6e;
            color: #333;
            padding: 5px 15px;
            border-radius: 15px;
            font-size: 12px;
            font-weight: bold;
            display: inline-block;
            margin-bottom: 15px;
        }

        h1 { color: #2c3e50; margin-bottom: 10px; text-align: center; }
        h2 { color: #2c3e50; margin-bottom: 15px; text-align: center; }
        p { color: #666; margin-bottom: 20px; text-align: center; }

        .btn {
            background: #6c5ce7;
            color: white;
            border: none;
            padding: 15px 30px;
            font-size: 18px;
            border-radius: 30px;
            cursor: pointer;
            width: 100%;
            font-weight: bold;
            margin-top: 10px;
        }

        .btn-success { background: #00b894; }

        input {
            width: 100%;
            padding: 12px;
            margin-bottom: 12px;
            border: 2px solid #ddd;
            border-radius: 10px;
            font-size: 16px;
            text-align: center;
        }

        input:focus { border-color: #6c5ce7; outline: none; }

        .group-card {
            background: #f8f9fa;
            padding: 12px;
            margin-bottom: 10px;
            border-radius: 10px;
            cursor: pointer;
            text-align: right;
            border: 2px solid transparent;
        }

        .group-card:hover { background: #eee; }
        .group-card.selected { border-color: #00b894; background: #e6fffa; }
        
        .group-name { font-weight: bold; color: #333; }
        .group-days { color: #6c5ce7; font-size: 14px; }
        .group-time { color: #e17055; font-size: 14px; font-weight: bold; }

        .screen { display: none; }
        .screen.active { display: block; }

        .error-msg {
            background: #ffdada;
            color: #d63031;
            padding: 10px;
            border-radius: 8px;
            margin-bottom: 10px;
            display: none;
            font-size: 14px;
        }

        .success-icon { font-size: 50px; text-align: center; display: block; }
    </style>
</head>
<body>

<div class="container">
    <div class="badge">أستاذة نسمة ماهر</div>

    <!-- الشاشة 1: الترحيب -->
    <div id="screen1" class="screen active">
        <h1>أهلاً بك 👋</h1>
        <p>احجز مجموعتك بسهولة<br>وتواصل مع أستاذة نسمة</p>
        <button class="btn" onclick="showScreen(2)">احجز الآن</button>
    </div>

    <!-- الشاشة 2: إدخال البيانات -->
    <div id="screen2" class="screen">
        <h2>بيانات الطالب</h2>
        
        <input type="text" id="studentName" placeholder="👤 اسم الطالب">
        <input type="tel" id="studentPhone" placeholder="📱 رقم جوال الطالب">
        <input type="tel" id="parentPhone" placeholder="📞 رقم ولي الأمر">

        <div class="error-msg" id="errorMsg"></div>

        <h3 style="text-align: right; margin: 15px 0 10px; font-size: 16px;">اختر مجموعتك:</h3>

        <div class="group-card" onclick="selectGroup(this, 'المجموعة الأولى', 'السبت والإثنين والأربعاء', 'الساعة 2 ظهراً')">
            <div class="group-name">المجموعة الأولى</div>
            <div class="group-days">السبت والإثنين والأربعاء</div>
            <div class="group-time">الساعة 2 ظهراً</div>
        </div>

        <div class="group-card" onclick="selectGroup(this, 'المجموعة الثانية', 'السبت والإثنين والأربعاء', 'الساعة 6 مساءً')">
            <div class="group-name">المجموعة الثانية</div>
            <div class="group-days">السبت والإثنين والأربعاء</div>
            <div class="group-time">الساعة 6 مساءً</div>
        </div>

        <div class="group-card" onclick="selectGroup(this, 'المجموعة الثالثة', 'الأحد والثلاثاء والخميس', 'الساعة 2 ظهراً')">
            <div class="group-name">المجموعة الثالثة</div>
            <div class="group-days">الأحد والثلاثاء والخميس</div>
            <div class="group-time">الساعة 2 ظهراً</div>
        </div>

        <div class="group-card" onclick="selectGroup(this, 'المجموعة الرابعة', 'الأحد والثلاثاء والخميس', 'الساعة 4 عصراً')">
            <div class="group-name">المجموعة الرابعة</div>
            <div class="group-days">الأحد والثلاثاء والخميس</div>
            <div class="group-time">الساعة 4 عصراً</div>
        </div>

        <button class="btn btn-success" onclick="submitBooking()">تأكيد الحجز ✅</button>
    </div>

    <!-- الشاشة 3: جاري الإرسال -->
    <div id="screen3" class="screen">
        <span class="success-icon">📤</span>
        <h2>جاري الإرسال...</h2>
    </div>

    <!-- الشاشة 4: النجاح -->
    <div id="screen4" class="screen">
        <span class="success-icon">✅</span>
        <h2>تم الحجز!</h2>
        <p style="font-weight: bold; color: #00b894;">تم إرسال البيانات لأستاذة نسمة</p>
        <p id="bookingDetails" style="font-size: 14px; color: #666; margin-bottom: 15px;"></p>
        
        <button class="btn" style="background: #e17055;" onclick="location.reload()">🔄 حجز جديد</button>
    </div>
</div>

<script>
    // غير رقم الهاتف هنا
    const TEACHER_PHONE = "201012661747";
    
    let selectedGroupName = "";
    let selectedDays = "";
    let selectedTime = "";

    function showScreen(num) {
        document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
        document.getElementById('screen' + num).classList.add('active');
    }

    function selectGroup(el, name, days, time) {
        document.querySelectorAll('.group-card').forEach(c => c.classList.remove('selected'));
        el.classList.add('selected');
        selectedGroupName = name;
        selectedDays = days;
        selectedTime = time;
        document.getElementById('errorMsg').style.display = 'none';
    }

    function submitBooking() {
        const name = document.getElementById('studentName').value.trim();
        const phone = document.getElementById('studentPhone').value.trim();
        const parent = document.getElementById('parentPhone').value.trim();
        const errorEl = document.getElementById('errorMsg');

        if (!name || !phone || !parent) {
            errorEl.innerText = "⚠️ من فضلك املأ جميع الحقول";
            errorEl.style.display = "block";
            return;
        }

        if (!selectedGroupName) {
            errorEl.innerText = "⚠️ اختر المجموعة";
            errorEl.style.display = "block";
            return;
        }

        errorEl.style.display = "none";
        showScreen(3);

        // رسالة الواتساب
        const text = `*حجز مجموعة - أستاذة نسمة*

👤 الاسم: ${name}
📱 جوال الطالب: ${phone}
📞 ولي الأمر: ${parent}
🏫 المجموعة: ${selectedGroupName}
📅 الأيام: ${selectedDays}
⏰ التوقيت: ${selectedTime}`;

        const whatsappUrl = 'https://wa.me/' + TEACHER_PHONE + '?text=' + encodeURIComponent(text);

        setTimeout(() => {
            showScreen(4);
            document.getElementById('bookingDetails').innerText = selectedGroupName + ' - ' + selectedTime;
            window.open(whatsappUrl, '_blank');
        }, 1500);
    }
</script>

</body>
</html>
